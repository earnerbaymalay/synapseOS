# ==============================================================================
# ~/.config/sway/config — SynapseOS Dual-Session Wayland Tiling Configuration
# Aesthetic: Catppuccin Mocha Mauve (#cba6f7), Liquid Silver Chrome (#cdd6f4),
#            Obsidian Crust (#11111b), Base (#1e1e2e)
# ==============================================================================

# --- Core Variables ---
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $term_alt foot
set $menu /usr/bin/synapse-hud

# --- Palette Tokens (Catppuccin Mocha + Liquid Chrome + Obsidian Crust) ---
set $crust    #11111b
set $base     #1e1e2e
set $mauve    #cba6f7
set $silver   #cdd6f4

# --- Typography & Window Geometry ---
font pango:JetBrainsMono Nerd Font Mono 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4
smart_borders on

# --- Output & Idle Management ---
output * bg #11111b solid_color
output * bg /usr/share/backgrounds/synapseos/synapse-monolith-mauve.jpg fill #11111b
exec swaybg -i /usr/share/backgrounds/synapseos/monolith-mauve.png -m fill 2>/dev/null || swaybg -i /usr/share/backgrounds/synapseos/synapse-monolith-mauve.jpg -m fill 2>/dev/null || true
exec synapse-theme --restore

# Screensaver is not a lock: 5 min -> geodesic torus, 10 min -> displays off
exec swayidle -w \
    timeout 300 'synapse-screensaver --launch' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"'

# --- Client Window Border Colors ---
# class                 border   backgr.  text     indicator child_border
client.focused          #cba6f7  #1e1e2e  #cdd6f4  #cba6f7   #cba6f7
client.focused_inactive #1e1e2e  #11111b  #cdd6f4  #1e1e2e   #1e1e2e
client.unfocused        #11111b  #11111b  #cdd6f4  #11111b   #11111b
client.urgent           #cba6f7  #1e1e2e  #cdd6f4  #cba6f7   #cba6f7
client.placeholder      #11111b  #11111b  #cdd6f4  #11111b   #11111b
client.background       #11111b

# --- Mnemonic Application Launchers (Super + First Letter) ---
bindsym Mod4+s exec /usr/bin/synapse-hud
bindsym Mod4+space exec /usr/bin/synapse-hud
bindsym Mod4+d exec /usr/bin/synapse-hud
# Secondary prompt palette: /usr/bin/quickfire
bindsym Mod4+t exec kitty
bindsym Mod4+Return exec kitty
bindsym Mod4+Shift+Return exec foot
bindsym Mod4+b exec chromium
bindsym Mod4+f exec thunar
bindsym Mod4+n exec /usr/bin/synapse-notes
bindsym Mod4+c exec [ -x /usr/bin/calamares ] && calamares -d || /usr/bin/galculator
bindsym Mod4+i exec calamares -d
bindsym Mod4+a exec /usr/bin/audio-switch
bindsym Mod4+w exec /usr/bin/synapse-welcome
bindsym Mod4+slash exec /usr/bin/synapse-shortcuts
bindsym Mod4+question exec /usr/bin/synapse-shortcuts
bindsym Mod4+m exec synapse-theme --menu
bindsym Mod4+Ctrl+t exec synapse-theme --menu
bindsym Mod4+p exec /usr/bin/sec-status

# --- Window Closing & Session Management (Esc, Mouse & Keys) ---
bindsym Mod4+q kill
bindsym Mod4+Escape kill
bindsym Mod4+Shift+q kill
bindsym Mod4+Shift+c reload
bindsym Mod4+Shift+e exec swaymsg exit

# Mouse Window Actions:
# Super+Left-drag moves, Super+Right-drag resizes, Super+Middle-click closes window
floating_modifier Mod4 normal
bindsym --whole-window Mod4+button2 kill
bindsym --border Mod4+button3 kill
bindsym --border button2 kill

# --- Direct Window Adjustment Shortcuts (No Modal Mode Required) ---
bindsym Mod4+Ctrl+Left resize shrink width 40px
bindsym Mod4+Ctrl+Right resize grow width 40px
bindsym Mod4+Ctrl+Up resize grow height 40px
bindsym Mod4+Ctrl+Down resize shrink height 40px
bindsym Mod4+bracketleft resize shrink width 40px
bindsym Mod4+bracketright resize grow width 40px

# --- Keybindings: Wayland Screenshots & Clipboard (grim + slurp + wl-clipboard) ---
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy

# --- Keybindings: Focus Navigation ---
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- Keybindings: Move Containers ---
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Keybindings: Workspaces (1 - 10) ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# --- Keybindings: Layout & Scratchpad ---
bindsym $mod+backslash splith
bindsym $mod+v splitv
bindsym $mod+Shift+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+f fullscreen
bindsym F11 fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+a focus parent
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# --- Resize Mode ---
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- Comprehensive Floating Window Rules ---
for_window [app_id="synapse-screensaver"] fullscreen enable
for_window [app_id="(?i)synapse-hud"] floating enable, border pixel 0
for_window [class="(?i)synapse-hud"] floating enable, border pixel 0
for_window [app_id="(?i)synapse-welcome"] floating enable, move position center
for_window [class="(?i)synapse-welcome"] floating enable, move position center
for_window [app_id="(?i)synapse-settings"] floating enable, move position center
for_window [class="(?i)synapse-settings"] floating enable, move position center
for_window [app_id="(?i)synapse-notes"] floating enable, move position center
for_window [class="(?i)synapse-notes"] floating enable, move position center
for_window [app_id="synapse-shortcuts"] floating enable, resize set 860 620, move position center
for_window [title=".*Keybindings Cheat Sheet.*"] floating enable, resize set 860 620, move position center
for_window [app_id="(?i)quickfire"] floating enable, border pixel 2
for_window [class="(?i)quickfire"] floating enable, border pixel 2
for_window [app_id="(?i)calamares"] floating enable, move position center
for_window [class="(?i)calamares"] floating enable, move position center
for_window [app_id="(?i)galculator"] floating enable, move position center
for_window [class="(?i)galculator"] floating enable, move position center
for_window [app_id="(?i)pavucontrol"] floating enable, move position center
for_window [class="(?i)pavucontrol"] floating enable, move position center
for_window [app_id="(?i)audio-switch"] floating enable, move position center
for_window [class="(?i)audio-switch"] floating enable, move position center
for_window [title="(?i)Audio Output Switcher"] floating enable, move position center
for_window [app_id="(?i)sec-status"] floating enable, resize set 800 550, move position center
for_window [title=".*Security & Anonymity Audit.*"] floating enable, resize set 800 550, move position center
for_window [app_id="(?i)nm-connection-editor"] floating enable, move position center
for_window [class="(?i)nm-connection-editor"] floating enable, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable

# --- Waybar Status Bar ---
bar {
    swaybar_command waybar
}

# --- Autostart Services & Onboarding ---

# In live sessions or initial login, autostart synapse-welcome centered so user has an immediate cockpit
exec [ -f /etc/sudoers.d/00-synapse-live ] || [ -x /usr/bin/calamares ] || [ ! -f ~/.config/synapse/.onboarding_complete ] && /usr/bin/synapse-welcome --autostart

include /etc/sway/config.d/*
