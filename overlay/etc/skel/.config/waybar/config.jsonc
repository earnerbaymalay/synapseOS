// =============================================================================
// ~/.config/waybar/config.jsonc — SynapseOS Waybar Status Bar Configuration
// Palette: Obsidian Crust (#11111b), Base (#1e1e2e), Mauve (#cba6f7), Silver (#cdd6f4)
// =============================================================================
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": [
        "custom/menu",
        "custom/installer",
        "custom/terminal",
        "custom/ai",
        "sway/workspaces",
        "sway/mode",
        "sway/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/synapse",
        "custom/stealth",
        "custom/help",
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "tray",
        "custom/power"
    ],
    "custom/menu": {
        "format": "󰚩 SYNAPSE",
        "on-click": "/usr/bin/synapse-hud",
        "on-click-right": "/usr/bin/quickfire",
        "tooltip-format": "Synapse Cockpit\n[Left-Click] Command HUD\n[Right-Click] Quickfire AI"
    },
    "custom/hud": {
        "format": "󰚩 HUD",
        "on-click": "/usr/bin/synapse-hud",
        "on-click-right": "/usr/bin/quickfire",
        "tooltip-format": "Synapse Command HUD (Mod4+Space)\n[Left-Click] Command HUD\n[Right-Click] Quickfire AI"
    },
    "custom/installer": {
        "exec": "if [ -x /usr/bin/calamares ] || [ -f /etc/sudoers.d/00-synapse-live ]; then echo '{\"text\":\"󰐥 INSTALL SYNAPSEOS\",\"tooltip\":\"Launch Calamares Live System Installer\",\"class\":\"active\"}'; fi",
        "return-type": "json",
        "interval": 10,
        "on-click": "/usr/bin/calamares -d"
    },
    "custom/calamares": {
        "exec": "if [ -x /usr/bin/calamares ] || [ -f /etc/sudoers.d/00-synapse-live ]; then echo '{\"text\":\"󰐥 INSTALL SYNAPSEOS\",\"tooltip\":\"Launch Calamares Live System Installer\",\"class\":\"active\"}'; fi",
        "return-type": "json",
        "interval": 10,
        "on-click": "/usr/bin/calamares -d"
    },
    "custom/terminal": {
        "format": "󰞷 TERM",
        "on-click": "kitty",
        "tooltip-format": "Launch Kitty Terminal (Mod4+Return)"
    },
    "custom/ai": {
        "format": "󰚩 AI",
        "on-click": "/usr/bin/quickfire",
        "tooltip-format": "Launch Quickfire AI HUD (Mod4+Space)"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/window": {
        "max-length": 40,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%Y-%m-%d  %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/synapse": {
        "exec": "curl -sf http://127.0.0.1:8000/health >/dev/null 2>&1 && echo 'SYNAPSE: ONLINE' || echo 'SYNAPSE: STANDBY'",
        "interval": 15,
        "on-click": "/usr/bin/quickfire",
        "tooltip": false
    },
    "custom/stealth": {
        "exec": "/usr/bin/synapse-stealth 2>/dev/null || ( [ -f /etc/NetworkManager/conf.d/00-synapseos-stealth.conf ] && echo '{\"text\":\"󰒃 STEALTH: OK\",\"tooltip\":\"Prime Directive: MAC Randomization & Quad9 DoT Active\",\"class\":\"secure\"}' || echo '{\"text\":\"󰒃 STEALTH: WARN\",\"class\":\"warning\"}' )",
        "return-type": "json",
        "interval": 15,
        "on-click": "/usr/bin/sec-status"
    },
    "custom/help": {
        "format": "󰌌 HELP",
        "on-click": "/usr/bin/synapse-shortcuts",
        "tooltip-format": "Cyberdeck Navigation & Keybinding Guide (Mod4+/)"
    },
    "custom/shortcuts": {
        "format": "󰌌 KEYS",
        "on-click": "/usr/bin/synapse-shortcuts",
        "tooltip-format": "Cyberdeck Navigation & Keybinding Guide (Mod4+/)"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "RAM {}%"
    },
    "network": {
        "format-wifi": "NET {essid} ({signalStrength}%)",
        "format-ethernet": "NET {ipaddr}/{cidr}",
        "format-linked": "NET {ifname} (No IP)",
        "format-disconnected": "NET OFFLINE",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL MUTED",
        "on-click": "/usr/bin/audio-switch",
        "on-click-right": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "AC {capacity}%"
    },
    "tray": {
        "spacing": 10
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "/usr/bin/synapse-power",
        "tooltip-format": "Session & Power Management"
    }
}
