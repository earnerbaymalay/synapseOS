pkgname=synapse-themes
pkgver=0.1.0
pkgrel=3
pkgdesc="SynapseOS wallpapers (3 designs x accent variants), system theme switcher (Super+Ctrl+T) and geodesic torus screensaver"
arch=('any')
url="https://github.com/earnerbaymalay/synapseOS"
license=('MIT')
depends=('bash' 'python' 'rofi' 'kitty' 'xfconf' 'xorg-xrandr' 'xprintidle' 'swaybg' 'libnotify')
optdepends=(
  'python-terminaltexteffects: tte effects for the screensaver brand reveal (AUR)'
  'foot: Wayland fallback terminal for the screensaver'
)
source=(
  'synapse-theme'
  'synapse-screensaver'
  'synapse-idle'
