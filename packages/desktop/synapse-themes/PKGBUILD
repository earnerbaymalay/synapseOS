# Maintainer: SynapseOS Engineering Team <maintainers@synapseos.org>
pkgname=synapse-themes
pkgver=0.1.0
pkgrel=1
pkgdesc="SynapseOS V4 wallpapers, system theme switcher (Super+Ctrl+T) and geodesic torus screensaver"
arch=('any')
url="https://github.com/earnerbaymalay/synapseOS"
license=('MIT')
depends=('bash' 'python' 'rofi' 'kitty' 'xfconf' 'xorg-xrandr' 'xprintidle' 'swaybg' 'libnotify')
optdepends=(
  'python-terminaltexteffects: tte effects for the screensaver brand reveal (AUR)'
  'foot: Wayland fallback terminal for the screensaver'
)
source=(
  'synapse-theme'
  'synapse-screensaver'
  'synapse-idle'
  'synapse-theme-restore.desktop'
  'synapse-idle.desktop'
  'synapse-screensaver.desktop'
  '01-synapse-obsidian-mauve.jpg'
  '02-synapse-ristretto-tungsten.jpg'
  '03-synapse-crimson-carbon.jpg'
  '04-synapse-platinum-chrome.jpg'
  '05-synapse-obsidian-unbranded.jpg'
)
sha256sums=('e023a90647fcaff9a181350444383d7f90029f5b69abe36fa7920a0f85693f3b'
            '2de6ca640e72d529667d42924ae13de9061209068955d24be1c68c90f5584dd6'
            '3edb549f83489e57d50dd0c0fed2ec09675459621848d7a50f09822b2986be10'
            '72456c7558db818fb155071c4686e83e1f03f97aa1de6826ac9eec2f943893a2'
            '862105cea2f2a67bfc70d1011ffd66f5a2b62e7f6e62fa92e046b03394feed0f'
            'ac1b728bf8d51da1621de4617eace24d2377ed4d1bd6695d3e2145261f4ec584'
            'be9156af352271b37cb9267b3366c633ed5a23a09614969528bbb98724c5f594'
            '8fcd592f3d6679f4b9a2f3711dc51e24fa731312db88f734d542fde172ff0af5'
            '333189c3fd80db658393296c54647c1c611907bc7389922b43b76742d2b87456'
            'bff47c7028cd0902c908eec9a6af8970f073624bdf133dc492c43bc3cdade1ed'
            'c250db67e1ec4b2cdebbe79ccb349345191e900bbd5aa650103a2fbe0b2b68f4')

package() {
  install -Dm755 synapse-theme "$pkgdir/usr/bin/synapse-theme"
  install -Dm755 synapse-screensaver "$pkgdir/usr/bin/synapse-screensaver"
  install -Dm755 synapse-idle "$pkgdir/usr/bin/synapse-idle"

  install -Dm644 synapse-theme-restore.desktop "$pkgdir/etc/xdg/autostart/synapse-theme-restore.desktop"
  install -Dm644 synapse-idle.desktop "$pkgdir/etc/xdg/autostart/synapse-idle.desktop"
  install -Dm644 synapse-screensaver.desktop "$pkgdir/usr/share/applications/synapse-screensaver.desktop"

  local wp
  for wp in 0{1..5}-synapse-*.jpg; do
    install -Dm644 "$wp" "$pkgdir/usr/share/backgrounds/synapseos/$wp"
  done
}
