package() {
  install -Dm755 synapse-theme "$pkgdir/usr/bin/synapse-theme"
  install -Dm755 synapse-screensaver "$pkgdir/usr/bin/synapse-screensaver"
  install -Dm755 synapse-idle "$pkgdir/usr/bin/synapse-idle"

  install -Dm644 synapse-theme-restore.desktop "$pkgdir/etc/xdg/autostart/synapse-theme-restore.desktop"
  install -Dm644 synapse-idle.desktop "$pkgdir/etc/xdg/autostart/synapse-idle.desktop"
  install -Dm644 synapse-screensaver.desktop "$pkgdir/usr/share/applications/synapse-screensaver.desktop"

  local wp
  for wp in synapse-*.jpg; do
    install -Dm644 "$wp" "$pkgdir/usr/share/backgrounds/synapseos/$wp"
  done
}
