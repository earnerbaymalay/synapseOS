def find_logo_asset():
    """Find the authentic vector or image logo across standard package and dev locations."""
    script_dir = Path(__file__).resolve().parent
    candidates = [
        "/usr/share/calamares/branding/synapseos/synapseos-logo.svg",
        "/etc/calamares/branding/synapseos/synapseos-logo.svg",
        "/usr/share/synapseos/branding/synapseos-logo.svg",
        script_dir / "../../installer/calamares/branding/synapseos/synapseos-logo.svg",
        Path.home() / "synapseOS/packages/installer/calamares/branding/synapseos/synapseos-logo.svg",
        Path.home() / "Desktop/AI CLI WORK/synapseOS/packages/installer/calamares/branding/synapseos/synapseos-logo.svg",
        Path.home() / "Desktop/SynapseOS_Flow_Assets/04_synapseos_wordmark_logo.png",
    ]
    for c in candidates:
        p = Path(c).resolve()
        if p.is_file() and p.stat().st_size > 0:
            return str(p)
    return None


def update_gtk_settings(settings_path: str, icon_theme: str):
    """Write or update gtk-icon-theme-name under [Settings] in GTK settings.ini."""
    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    lines = []
    if os.path.exists(settings_path):
        try:
            with open(settings_path, "r", encoding="utf-8") as f:
                lines = f.readlines()
        except Exception:
            lines = []

    settings_section_idx = -1
    icon_theme_idx = -1
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped == "[Settings]":
            settings_section_idx = i
        elif stripped.startswith("gtk-icon-theme-name") and settings_section_idx != -1:
            icon_theme_idx = i
            break
        elif stripped.startswith("[") and settings_section_idx != -1 and i > settings_section_idx:
            break

    entry = f"gtk-icon-theme-name = {icon_theme}\n"
    if icon_theme_idx != -1:
        lines[icon_theme_idx] = entry
    elif settings_section_idx != -1:
        lines.insert(settings_section_idx + 1, entry)
    else:
        if lines and not lines[-1].endswith("\n"):
            lines.append("\n")
        lines.append("[Settings]\n")
        lines.append(entry)

    with open(settings_path, "w", encoding="utf-8") as f:
        f.writelines(lines)


