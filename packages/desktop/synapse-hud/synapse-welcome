#!/usr/bin/env python3
"""synapse-welcome — SynapseOS Welcome & Onboarding Experience.

Presents the user with:
  1. Metallic Icon Pack Selection (Liquid Chrome, Smoked Obsidian, Radial Tungsten, Aerospace Billet)
  2. Wallpaper & System Accent Selection (Mauve, Tungsten, Crimson, Sapphire, Emerald)
  3. Screensaver Experience (Purple Donut Torus, Cyber Matrix Brand, Continuous Cycle)
  4. Privacy & Autonomous AI Engine Status
"""

import os
import sys
import subprocess
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QButtonGroup, QFrame, QRadioButton,
    QStackedWidget, QScrollArea, QMessageBox
)
from PyQt6.QtCore import Qt, QSize
from PyQt6.QtGui import QFont, QIcon, QPixmap

CONFIG_DIR = os.path.expanduser("~/.config/synapse")
ONBOARDING_FLAG = os.path.join(CONFIG_DIR, ".onboarding_complete")

class OnboardingWizard(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("SynapseOS · Onboarding Experience")
        self.resize(880, 680)
        self.center_on_screen()
        
        # State
        self.selected_icon_theme = "Synapse-Liquid-Chrome"
        self.selected_wallpaper = "monolith-mauve"
        self.selected_screensaver = "torus"

        self.init_ui()

    def center_on_screen(self):
        screen = QApplication.primaryScreen()
        if screen:
            rect = screen.availableGeometry()
            self.move(
                (rect.width() - self.width()) // 2,
                (rect.height() - self.height()) // 2
            )

    def init_ui(self):
        self.setStyleSheet("""
            QMainWindow {
                background-color: #11111b;
            }
            QWidget {
                color: #cdd6f4;
                font-family: 'JetBrains Mono', monospace;
            }
            QFrame#card {
                background-color: #181825;
                border: 1px solid #313244;
                border-radius: 12px;
                padding: 14px;
            }
            QFrame#card:hover {
                border: 1px solid #cba6f7;
                background-color: #1e1e2e;
            }
            QFrame#cardSelected {
                background-color: #1e1e2e;
                border: 2px solid #cba6f7;
                border-radius: 12px;
                padding: 13px;
            }
            QPushButton#navBtn {
                background-color: #313244;
                color: #cdd6f4;
                border: 1px solid #45475a;
                border-radius: 8px;
                padding: 10px 20px;
                font-weight: bold;
                font-size: 13px;
            }
            QPushButton#navBtn:hover {
                background-color: #45475a;
                border: 1px solid #cba6f7;
            }
            QPushButton#primaryBtn {
                background-color: #cba6f7;
                color: #11111b;
                border: none;
                border-radius: 8px;
                padding: 12px 26px;
                font-weight: bold;
                font-size: 14px;
            }
            QPushButton#primaryBtn:hover {
                background-color: #b4befe;
            }
            QRadioButton {
                font-size: 13px;
                spacing: 8px;
            }
            QRadioButton::indicator {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border: 2px solid #6c7086;
                background-color: #181825;
            }
            QRadioButton::indicator:checked {
                border: 2px solid #cba6f7;
                background-color: #cba6f7;
            }
        """)

        central = QWidget()
        self.setCentralWidget(central)
        root_layout = QVBoxLayout(central)
        root_layout.setContentsMargins(36, 28, 36, 28)
        root_layout.setSpacing(20)

        # 1. Header Banner
        header = QVBoxLayout()
        header.setSpacing(6)
        
        title_box = QHBoxLayout()
        title = QLabel("SYNAPSE OS · ONBOARDING EXPERIENCE")
        title.setFont(QFont("JetBrains Mono", 18, QFont.Weight.Bold))
        title.setStyleSheet("color: #cba6f7; letter-spacing: 1px;")
        title_box.addWidget(title)
        title_box.addStretch()

        badge = QLabel("x86-64-v3 · BORE")
        badge.setStyleSheet("background-color: #313244; color: #a6adc8; border-radius: 6px; padding: 4px 10px; font-size: 11px;")
        title_box.addWidget(badge)
        header.addLayout(title_box)

        quote = QLabel("“System aims for minimal if not 0 telemetry and prioritises anonymisation without degradation of service.”")
        quote.setStyleSheet("color: #bac2de; font-style: italic; font-size: 12px;")
        quote.setWordWrap(True)
        header.addWidget(quote)

        root_layout.addLayout(header)

        # 2. Main Stacked Pages
        self.stack = QStackedWidget()
        self.stack.addWidget(self.create_icon_page())
        self.stack.addWidget(self.create_wallpaper_page())
        self.stack.addWidget(self.create_screensaver_page())
        self.stack.addWidget(self.create_security_page())
        root_layout.addWidget(self.stack, 1)

        # 3. Bottom Navigation Bar
        nav_layout = QHBoxLayout()
        self.back_btn = QPushButton("◀ Back")
        self.back_btn.setObjectName("navBtn")
        self.back_btn.clicked.connect(self.prev_page)
        self.back_btn.setEnabled(False)
        nav_layout.addWidget(self.back_btn)

        self.page_indicator = QLabel("Step 1 of 4: Metallic Icons")
        self.page_indicator.setStyleSheet("color: #a6adc8; font-size: 12px;")
        self.page_indicator.setAlignment(Qt.AlignmentFlag.AlignCenter)
        nav_layout.addWidget(self.page_indicator, 1)

        self.next_btn = QPushButton("Next: Wallpapers ▶")
        self.next_btn.setObjectName("primaryBtn")
        self.next_btn.clicked.connect(self.next_page)
        nav_layout.addWidget(self.next_btn)

        root_layout.addLayout(nav_layout)

    # --- Page 1: Metallic Icon Suites ---
    def create_icon_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setSpacing(14)

        intro = QLabel("Choose your Metallic & Reflective Icon Theme:")
        intro.setStyleSheet("font-size: 14px; font-weight: bold; color: #cdd6f4;")
        layout.addWidget(intro)

        self.icon_cards = []
        icons_data = [
            ("Synapse-Liquid-Chrome", "Liquid Mauve Chrome",
             "High-gloss mirror chrome finish with 45° diamond chamfers and liquid mauve sheen.", "✨"),
            ("Synapse-Smoked-Obsidian", "Smoked Obsidian & Neon",
             "Mirror-finish jet-black ceramic dish with knurled metal rim and glowing purple conduit.", "🌑"),
            ("Synapse-Radial-Tungsten", "Radial Milled Tungsten",
             "Concentric lathe tool marks with anisotropic cross-reflection and singularity torus.", "⚙️"),
            ("Synapse-Aerospace-Billet", "Aerospace Billet & Satin",
             "Brushed titanium chassis plate with bead-blasted satin mauve pocket and micro-bolts.", "🛡️")
        ]

        grid = QVBoxLayout()
        grid.setSpacing(10)
        self.icon_button_group = QButtonGroup(self)

        for theme_id, name, desc, badge_icon in icons_data:
            card = QFrame()
            card.setObjectName("cardSelected" if theme_id == self.selected_icon_theme else "card")
            card.setCursor(Qt.CursorShape.PointingHandCursor)
            
            c_layout = QHBoxLayout(card)
            c_layout.setContentsMargins(14, 10, 14, 10)
            c_layout.setSpacing(14)

            rb = QRadioButton()
            rb.setChecked(theme_id == self.selected_icon_theme)
            self.icon_button_group.addButton(rb)
            c_layout.addWidget(rb)

            text_box = QVBoxLayout()
            text_box.setSpacing(3)
            
            h_line = QHBoxLayout()
            t_label = QLabel(f"{badge_icon}  {name}")
            t_label.setFont(QFont("JetBrains Mono", 13, QFont.Weight.Bold))
            t_label.setStyleSheet("color: #ffffff;")
            h_line.addWidget(t_label)
            h_line.addStretch()
            text_box.addLayout(h_line)

            d_label = QLabel(desc)
            d_label.setStyleSheet("color: #a6adc8; font-size: 11px;")
            d_label.setWordWrap(True)
            text_box.addWidget(d_label)
            c_layout.addLayout(text_box, 1)

            # Click handler
            card.mousePressEvent = lambda ev, tid=theme_id, c=card, r=rb: self.select_icon_theme(tid, c, r)
            self.icon_cards.append((theme_id, card, rb))
            grid.addWidget(card)

        layout.addLayout(grid)
        layout.addStretch()
        return page

    def select_icon_theme(self, theme_id, card_widget, radio_btn):
        self.selected_icon_theme = theme_id
        radio_btn.setChecked(True)
        for tid, card, rb in self.icon_cards:
            card.setObjectName("cardSelected" if tid == theme_id else "card")
            card.style().unpolish(card)
            card.style().polish(card)

    # --- Page 2: Wallpapers & Accents ---
    def create_wallpaper_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setSpacing(14)

        intro = QLabel("Select your Cyberdeck Wallpaper & Accent Variant:")
        intro.setStyleSheet("font-size: 14px; font-weight: bold; color: #cdd6f4;")
        layout.addWidget(intro)

        wallpapers = [
            ("monolith-mauve", "Monolith · Mauve (Default)", "Classic monolithic geometry in deep Mauve (#cba6f7)"),
            ("tower-mauve", "Basalt Tower · Mauve", "Brutalist cyberdeck pillars under ultraviolet aurora"),
            ("carbon-mauve", "Forged Carbon · Mauve", "High-density forged carbon weave with violet accents"),
            ("monolith-tungsten", "Monolith · Tungsten", "Industrial warm tungsten anodized finish (#fab387)"),
            ("carbon-crimson", "Forged Carbon · Crimson", "High-contrast stealth crimson weave (#f38ba8)"),
            ("monolith-sapphire", "Monolith · Sapphire", "Cold aerospace sapphire chrome (#74c7ec)"),
            ("monolith-emerald", "Monolith · Emerald", "Matrix phosphor terminal green (#a6e3a1)")
        ]

        self.wp_cards = []
        grid = QVBoxLayout()
        grid.setSpacing(8)

        for wp_id, name, desc in wallpapers:
            card = QFrame()
            card.setObjectName("cardSelected" if wp_id == self.selected_wallpaper else "card")
            card.setCursor(Qt.CursorShape.PointingHandCursor)

            c_layout = QHBoxLayout(card)
            c_layout.setContentsMargins(14, 8, 14, 8)
            c_layout.setSpacing(12)

            rb = QRadioButton()
            rb.setChecked(wp_id == self.selected_wallpaper)
            c_layout.addWidget(rb)

            text_box = QVBoxLayout()
            text_box.setSpacing(2)
            t_label = QLabel(name)
            t_label.setFont(QFont("JetBrains Mono", 12, QFont.Weight.Bold))
            text_box.addWidget(t_label)
            d_label = QLabel(desc)
            d_label.setStyleSheet("color: #a6adc8; font-size: 11px;")
            text_box.addWidget(d_label)
            c_layout.addLayout(text_box, 1)

            card.mousePressEvent = lambda ev, wid=wp_id, c=card, r=rb: self.select_wallpaper(wid, c, r)
            self.wp_cards.append((wp_id, card, rb))
            grid.addWidget(card)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet("QScrollArea { border: none; background: transparent; }")
        scroll_content = QWidget()
        scroll_content.setLayout(grid)
        scroll.setWidget(scroll_content)
        layout.addWidget(scroll)
        return page

    def select_wallpaper(self, wp_id, card_widget, radio_btn):
        self.selected_wallpaper = wp_id
        radio_btn.setChecked(True)
        for wid, card, rb in self.wp_cards:
            card.setObjectName("cardSelected" if wid == wp_id else "card")
            card.style().unpolish(card)
            card.style().polish(card)

    # --- Page 3: Screensaver Experience ---
    def create_screensaver_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setSpacing(16)

        intro = QLabel("Choose your Idle Terminal Screensaver Experience:")
        intro.setStyleSheet("font-size: 14px; font-weight: bold; color: #cdd6f4;")
        layout.addWidget(intro)

        screensavers = [
            ("torus", "🟣 The Purple Donut (Geodesic Neon Torus)",
             "Rotating mathematical 3D geodesic torus wireframe rendered in Braille Unicode on OLED black."),
            ("brand", "⚡ Decrypted Cyber Matrix & Brand Reveal",
             "Terminal matrix stream resolving into the glowing SYNAPSE master cipher glyph."),
            ("cycle", "🌌 Continuous Singularity Cycle",
             "Seamlessly alternates between the orbital torus (40s) and cipher brand reveal (12s).")
        ]

        self.ss_cards = []
        for ss_id, name, desc in screensavers:
            card = QFrame()
            card.setObjectName("cardSelected" if ss_id == self.selected_screensaver else "card")
            card.setCursor(Qt.CursorShape.PointingHandCursor)

            c_layout = QVBoxLayout(card)
            c_layout.setContentsMargins(16, 12, 16, 12)
            c_layout.setSpacing(4)

            h_box = QHBoxLayout()
            rb = QRadioButton(name)
            rb.setFont(QFont("JetBrains Mono", 12, QFont.Weight.Bold))
            rb.setChecked(ss_id == self.selected_screensaver)
            h_box.addWidget(rb)
            h_box.addStretch()
            c_layout.addLayout(h_box)

            d_label = QLabel(desc)
            d_label.setStyleSheet("color: #a6adc8; font-size: 11px; margin-left: 24px;")
            d_label.setWordWrap(True)
            c_layout.addWidget(d_label)

            card.mousePressEvent = lambda ev, sid=ss_id, c=card, r=rb: self.select_screensaver(sid, c, r)
            self.ss_cards.append((ss_id, card, rb))
            layout.addWidget(card)

        # Test Screensaver Button
        test_box = QHBoxLayout()
        test_btn = QPushButton("👁️ Test-Fire Screensaver in Fullscreen")
        test_btn.setObjectName("navBtn")
        test_btn.clicked.connect(self.preview_screensaver)
        test_box.addWidget(test_btn)
        test_box.addStretch()
        layout.addLayout(test_box)

        layout.addStretch()
        return page

    def select_screensaver(self, ss_id, card_widget, radio_btn):
        self.selected_screensaver = ss_id
        radio_btn.setChecked(True)
        for sid, card, rb in self.ss_cards:
            card.setObjectName("cardSelected" if sid == ss_id else "card")
            card.style().unpolish(card)
            card.style().polish(card)

    def preview_screensaver(self):
        subprocess.Popen([
            "synapse-screensaver", "--launch", "--mode", self.selected_screensaver
        ])

    # --- Page 4: Security & Summary ---
    def create_security_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setSpacing(16)

        intro = QLabel("System Security, Anonymity & Ready Status:")
        intro.setStyleSheet("font-size: 14px; font-weight: bold; color: #cdd6f4;")
        layout.addWidget(intro)

        specs = [
            ("🛡️ Prime Directive", "Active: MAC address randomization on scan & links; Quad9 DoT (9.9.9.9:853)"),
            ("🌐 Zero-Telemetry Web", "Chromium configured with telemetry, sync, and cloud reporting purged"),
            ("🤖 Local Autonomous AI", "Ollama daemon running locally (port 11434); background model warming"),
            ("🚀 Cyberdeck Command HUD", "Quickfire HUD accessible at Super+Space with keyboard hotkeys & mouse tiles")
        ]

        for title, desc in specs:
            card = QFrame()
            card.setObjectName("card")
            c_layout = QVBoxLayout(card)
            c_layout.setContentsMargins(14, 10, 14, 10)
            c_layout.setSpacing(3)
            
            t = QLabel(title)
            t.setFont(QFont("JetBrains Mono", 12, QFont.Weight.Bold))
            t.setStyleSheet("color: #cba6f7;")
            c_layout.addWidget(t)

            d = QLabel(desc)
            d.setStyleSheet("color: #bac2de; font-size: 11px;")
            c_layout.addWidget(d)
            layout.addWidget(card)

        layout.addStretch()
        return page

    # --- Navigation Logic ---
    def next_page(self):
        idx = self.stack.currentIndex()
        if idx < self.stack.count() - 1:
            self.stack.setCurrentIndex(idx + 1)
            self.update_nav()
        else:
            self.apply_and_finish()

    def prev_page(self):
        idx = self.stack.currentIndex()
        if idx > 0:
            self.stack.setCurrentIndex(idx - 1)
            self.update_nav()

    def update_nav(self):
        idx = self.stack.currentIndex()
        self.back_btn.setEnabled(idx > 0)
        
        titles = [
            "Step 1 of 4: Metallic Icons",
            "Step 2 of 4: Wallpapers & Accents",
            "Step 3 of 4: Idle Screensaver",
            "Step 4 of 4: Cyberdeck Verification"
        ]
        self.page_indicator.setText(titles[idx])

        if idx == self.stack.count() - 1:
            self.next_btn.setText("✨ Apply & Launch Cyberdeck")
        else:
            labels = ["Wallpapers ▶", "Screensaver ▶", "Verify & Finish ▶"]
            self.next_btn.setText(f"Next: {labels[idx]}")

    def apply_and_finish(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)

        # 1. Apply Icon Theme (XFCE / GTK)
        try:
            subprocess.run([
                "xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", self.selected_icon_theme
            ], check=False)
            with open(os.path.join(CONFIG_DIR, "icon_theme"), "w") as f:
                f.write(self.selected_icon_theme + "\n")
        except Exception:
            pass

        # 2. Apply Wallpaper
        try:
            subprocess.run(["synapse-theme", self.selected_wallpaper], check=False)
        except Exception:
            pass

        # 3. Save Screensaver Preference
        try:
            with open(os.path.join(CONFIG_DIR, "screensaver_mode"), "w") as f:
                f.write(self.selected_screensaver + "\n")
        except Exception:
            pass

        # 4. Mark Onboarding Complete
        try:
            with open(ONBOARDING_FLAG, "w") as f:
                f.write("completed\n")
        except Exception:
            pass

        # 5. Launch HUD or notify
        try:
            subprocess.Popen(["synapse-hud"])
        except Exception:
            pass

        self.close()


def main():
    if "--autostart" in sys.argv:
        if os.path.exists(ONBOARDING_FLAG):
            sys.exit(0)
    app = QApplication(sys.argv)
    wizard = OnboardingWizard()
    wizard.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
