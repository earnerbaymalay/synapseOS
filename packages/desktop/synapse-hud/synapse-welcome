    def launch_cmd(self, cmd):
        try:
            subprocess.Popen(["bash", "-c", cmd], start_new_session=True)
        except Exception:
            pass

    # --- Navigation Logic ---
    def next_page(self):
        idx = self.stack.currentIndex()
        if idx < self.stack.count() - 1:
            self.stack.setCurrentIndex(idx + 1)
            self.update_nav()
        else:
            self.apply_and_finish()

    def prev_page(self):
        idx = self.stack.currentIndex()
        if idx > 0:
            self.stack.setCurrentIndex(idx - 1)
            self.update_nav()

    def update_nav(self):
        idx = self.stack.currentIndex()
        self.back_btn.setEnabled(idx > 0)

        titles = [
            "Step 1 of 5: Operator Identity Questionnaire",
            "Step 2 of 5: Metallic Icons",
            "Step 3 of 5: Wallpapers & Accents",
            "Step 4 of 5: Idle Screensaver",
            "Step 5 of 5: Cyberdeck Verification"
        ]
        self.page_indicator.setText(titles[idx])

        if idx == self.stack.count() - 1:
            self.next_btn.setText("✨ Apply & Launch Cyberdeck")
        else:
            labels = ["Metallic Icons ▶", "Wallpapers ▶", "Screensaver ▶", "Verify & Finish ▶"]
            self.next_btn.setText(f"Next: {labels[idx]}")

    def apply_and_finish(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)

        # 0. Save Operator Profile Questionnaire
        try:
            profile = {
                "operator": self.input_username.text().strip() or "synapse",
                "hostname": self.input_hostname.text().strip() or "synapse-deck",
                "ai_copilot": self.input_ai_name.text().strip() or "Synapse",
                "persona": getattr(self, "selected_persona", "dev")
            }
            with open(os.path.join(CONFIG_DIR, "operator_profile.json"), "w", encoding="utf-8") as f:
                json.dump(profile, f, indent=2)
            with open(os.path.join(CONFIG_DIR, "operator"), "w", encoding="utf-8") as f:
                f.write(profile["operator"] + "\n")
        except Exception:
            pass

        # 1. Apply Icon Theme (XFCE / GTK)
        try:
            subprocess.run([
                "xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", self.selected_icon_theme
            ], check=False)
            with open(os.path.join(CONFIG_DIR, "icon_theme"), "w") as f:
                f.write(self.selected_icon_theme + "\n")

            # Write to ~/.config/gtk-3.0/settings.ini & ~/.config/gtk-4.0/settings.ini
            gtk3_file = os.path.expanduser("~/.config/gtk-3.0/settings.ini")
            gtk4_file = os.path.expanduser("~/.config/gtk-4.0/settings.ini")
            for gtk_file in (gtk3_file, gtk4_file):
                try:
                    update_gtk_settings(gtk_file, self.selected_icon_theme)
                except Exception:
                    pass

            # Update via gsettings if available
            if shutil.which("gsettings"):
                subprocess.run([
                    "gsettings", "set", "org.gnome.desktop.interface", "icon-theme", self.selected_icon_theme
                ], check=False)
        except Exception:
            pass

        # 2. Apply Wallpaper
        try:
            subprocess.run(["synapse-theme", self.selected_wallpaper], check=False)
        except Exception:
            pass

        # 3. Save Screensaver Preference
        try:
            with open(os.path.join(CONFIG_DIR, "screensaver_mode"), "w") as f:
                f.write(self.selected_screensaver + "\n")
        except Exception:
            pass

        # 4. Mark Onboarding Complete
        try:
            with open(ONBOARDING_FLAG, "w") as f:
                f.write("completed\n")
        except Exception:
            pass

        # 5. Launch HUD or notify
        try:
            subprocess.Popen(["synapse-hud"])
        except Exception:
            pass

        self.close()


def main():
    if "--autostart" in sys.argv:
        if os.path.exists(ONBOARDING_FLAG):
            sys.exit(0)
    app = QApplication(sys.argv)
    wizard = OnboardingWizard()
    wizard.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
