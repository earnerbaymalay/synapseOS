#!/usr/bin/env python3
"""synapse-governor — Dynamic Thermal & Performance Governor Daemon for SynapseOS.

Phase 9 Autotuning:
Monitors local Ollama LLM inference bursts, Rust/C++ compilation jobs,
and CPU pressure. Elevates Intel/AMD P-state EPP to 'performance' and
unlocks sustained PL1/PL2 power envelopes during generation, stepping
gracefully down to 'balance_power' after 10 seconds of idle.
"""

import os
import sys
import glob
import time
import signal
import urllib.request
import json
from pathlib import Path

# Paths & Settings
EPP_GLOB = "/sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference"
GOV_GLOB = "/sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
OLLAMA_PS_URL = "http://127.0.0.1:11434/api/ps"
IDLE_COOLDOWN_SEC = 10.0
POLL_INTERVAL_SEC = 1.0

RUNNING = True


def handle_signals(sig, frame):
    global RUNNING
    RUNNING = False
    print(f"\n[synapse-governor] Received signal {sig}, restoring balanced state and exiting.")
    set_epp("balance_power")
    sys.exit(0)


def set_epp(target: str) -> bool:
    """Sets Energy Performance Preference (EPP) across all logical CPU cores."""
    success = False
    files = glob.glob(EPP_GLOB)
    if not files:
        # Fallback to scaling_governor if EPP is not supported
        gov = "performance" if target == "performance" else "powersave"
        for gf in glob.glob(GOV_GLOB):
            try:
                Path(gf).write_text(gov)
                success = True
            except Exception:
                pass
        return success

    for f in files:
        try:
            p = Path(f)
            curr = p.read_text().strip()
            if curr != target:
                p.write_text(target)
                success = True
        except Exception:
            pass
    return success


def get_current_epp() -> str:
    files = glob.glob(EPP_GLOB)
    if files:
        try:
            return Path(files[0]).read_text().strip()
        except Exception:
            pass
    govs = glob.glob(GOV_GLOB)
    if govs:
        try:
            return Path(govs[0]).read_text().strip()
        except Exception:
            pass
    return "unknown"


def is_process_bursting() -> bool:
    """Detects active LLM generation or compilation processes via /proc scanning."""
    burst_names = {"ollama_llama_se", "cargo", "rustc", "cc1", "cc1plus"}
    try:
        # Scan /proc for active matching processes
        for pid_entry in os.listdir("/proc"):
            if not pid_entry.isdigit():
                continue
            comm_path = os.path.join("/proc", pid_entry, "comm")
            try:
                with open(comm_path, "r", encoding="utf-8") as f:
                    name = f.read().strip()
                    if name in burst_names:
                        return True
            except (IOError, OSError):
                continue
    except Exception:
        pass
    return False


def is_ollama_generating() -> bool:
    """Checks if Ollama has an active resident model and active inference."""
    try:
        req = urllib.request.Request(OLLAMA_PS_URL, headers={"User-Agent": "synapse-governor"})
        with urllib.request.urlopen(req, timeout=0.5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            models = data.get("models", [])
            # If models are loaded, check process activity
            if models and is_process_bursting():
                return True
    except Exception:
        pass
    return is_process_bursting()


def print_status():
    epp = get_current_epp()
    generating = is_ollama_generating()
    print("==================================================")
    print(" SynapseOS Neural Hardware Governor Status")
    print("==================================================")
    print(f" Current CPU Energy Profile : {epp.upper()}")
    print(f" Inference Burst Detected   : {'YES (TURBO BOOST)' if generating else 'NO (IDLE)'}")
    print(f" Cooldown Window            : {IDLE_COOLDOWN_SEC}s")
    print(f" Reference Platform Target  : Dell 7490 (25W PL1 sustained)")
    print("==================================================")


def run_governor_loop():
    global RUNNING
    print(f"[synapse-governor] Initialized. Monitoring inference bursts (polling every {POLL_INTERVAL_SEC}s)...")
    
    last_burst_time = 0.0
    active_profile = get_current_epp()

    while RUNNING:
        burst = is_ollama_generating()
        now = time.time()

        if burst:
            last_burst_time = now
            if active_profile != "performance":
                set_epp("performance")
                active_profile = "performance"
                print(f"[synapse-governor] ⚡ LLM/Build Burst detected. Elevated CPU profile -> PERFORMANCE (25W PL1)")
        else:
            idle_duration = now - last_burst_time
            if active_profile == "performance" and idle_duration >= IDLE_COOLDOWN_SEC:
                set_epp("balance_power")
                active_profile = "balance_power"
                print(f"[synapse-governor] 🍃 System idle for {int(idle_duration)}s. Scaled down -> BALANCE_POWER (15W nominal)")

        time.sleep(POLL_INTERVAL_SEC)


def main():
    signal.signal(signal.SIGINT, handle_signals)
    signal.signal(signal.SIGTERM, handle_signals)

    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower()
        if cmd == "status":
            print_status()
            sys.exit(0)
        elif cmd == "boost":
            set_epp("performance")
            print("⚡ Manual Turbo Boost activated for 60 seconds...")
            time.sleep(60)
            set_epp("balance_power")
            print("🍃 Boost ended. Restored to balanced.")
            sys.exit(0)
        elif cmd in ("help", "--help", "-h"):
            print("Usage: synapse-governor [run | status | boost]")
            sys.exit(0)

    run_governor_loop()


if __name__ == "__main__":
    main()

