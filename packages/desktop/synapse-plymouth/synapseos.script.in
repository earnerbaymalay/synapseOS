# SynapseOS — Authentic 3D Liquid Chrome Monolith Boot Splash (Plymouth script plugin)
# Exact text size, liquid reflections, and metallic texture matching the boot video.
# Continuously plays realistic specular reflection loop with organic ambient breathing glow.

Window.SetBackgroundTopColor(0.067, 0.067, 0.106);
Window.SetBackgroundBottomColor(0.067, 0.067, 0.106);

FRAMES = @FRAMES@;
ACCENT_R = @ACCENT_R@;
ACCENT_G = @ACCENT_G@;
ACCENT_B = @ACCENT_B@;

# Authored canvas: 960x540 (16:9).
# Robust multi-resolution display scaling across 720p, 1080p, 1440p, 4K without distortion.
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

scale = screen_h / 540;
if (scale < 0.40) scale = 0.40;
if (scale > 4.00) scale = 4.00;

fw = Math.Int(960 * scale);
fh = Math.Int(540 * scale);
fx = Window.GetX() + Math.Int((screen_w - fw) / 2);
fy = Window.GetY() + Math.Int((screen_h - fh) / 2);

fun load(name) {
    img = Image(name);
    if (scale != 1.0) img = img.Scale(fw, fh);
    return img;
}

fun frame_name(n) {
    if (n < 10) return "frame-00" + n + ".png";
    if (n < 100) return "frame-0" + n + ".png";
    return "frame-" + n + ".png";
}

anim = Sprite();
anim.SetPosition(fx, fy, 1);
glow = Sprite();
glow.SetPosition(fx, fy, 2);
glow.SetOpacity(0);

global.tick = 0;
global.shown = -1;
global.held = 0;

# Plymouth calls refresh at 50 Hz; frames advance every 2 ticks (25 fps).
fun refresh_callback() {
    global.tick = global.tick + 1;
    frame_idx = Math.Int(global.tick / 2) % FRAMES;
    if (frame_idx != global.shown) {
        anim.SetImage(load(frame_name(frame_idx)));
        global.shown = frame_idx;
    }
    if (global.held == 0) {
        glow.SetImage(load("glow.png"));
        global.held = 1;
    }
    # Ambient breathing pulse
    phase = (global.tick / 50) * (2 * 3.14159 / 3.0);
    sine_norm = (Math.Sin(phase) + 1.0) / 2.0;
    pulse = sine_norm * sine_norm * (3.0 - 2.0 * sine_norm);
    glow.SetOpacity(0.12 + 0.45 * pulse);
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- LUKS passphrase prompt --------------------------------------------------
prompt_sprite = Sprite();
bullet_sprite = Sprite();
prompt_sprite.SetOpacity(0);
bullet_sprite.SetOpacity(0);

fun display_password_callback(prompt, bullets) {
    # Crisp Liquid Silver Chrome text (#cdd6f4)
    p = Image.Text(prompt, 0.804, 0.839, 0.957);
    prompt_sprite.SetImage(p);
    px = Window.GetX() + Math.Int((Window.GetWidth() - p.GetWidth()) / 2);
    py = fy + fh + Math.Int(24 * scale);
    prompt_sprite.SetPosition(px, py, 10);
    prompt_sprite.SetOpacity(1);

    dots = "";
    i = 0;
    while (i < bullets) {
        dots = dots + " • ";
        i = i + 1;
    }
    if (dots == "") dots = " _ ";
    b = Image.Text(dots, ACCENT_R, ACCENT_G, ACCENT_B);
    bullet_sprite.SetImage(b);
    bx = Window.GetX() + Math.Int((Window.GetWidth() - b.GetWidth()) / 2);
    by = py + p.GetHeight() + Math.Int(10 * scale);
    bullet_sprite.SetPosition(bx, by, 10);
    bullet_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Boot messages (e.g. fsck), bottom centre ----------------------------------
message_sprite = Sprite();
fun message_callback(text) {
    # Catppuccin Overlay1 / Telemetry Gray (#7f849c)
    m = Image.Text(text, 0.498, 0.518, 0.612);
    message_sprite.SetImage(m);
    mx = Window.GetX() + Math.Int((Window.GetWidth() - m.GetWidth()) / 2);
    my = Window.GetY() + Window.GetHeight() - m.GetHeight() - Math.Int(36 * scale);
    message_sprite.SetPosition(mx, my, 10);
    message_sprite.SetOpacity(1);
}
Plymouth.SetMessageFunction(message_callback);

# Leave the finished emblem on screen for the hand-off to the login screen.
fun quit_callback() {
    anim.SetImage(load("final.png"));
    glow.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
