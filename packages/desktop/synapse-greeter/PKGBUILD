pkgname=synapse-greeter
pkgver=0.1.0
pkgrel=1
pkgdesc="SynapseOS SDDM login theme: clock + system readout, chamfered panel with animated accent trails"
arch=('any')
url="https://github.com/earnerbaymalay/synapseOS"
license=('MIT')
depends=('sddm' 'qt6-declarative' 'synapse-themes' 'ttf-jetbrains-mono-nerd')
source=('Main.qml' 'metadata.desktop' 'theme.conf')
sha256sums=('3425522de5e38236e82066919830d8eedd33623c46c9e5046e9a381d1e701a6a'
            '0e352244f026b5c6a84df1b0a5e01d0e8c06c44e30216bf4d774adff5115c4c4'
            '2105e533a650700d15a50a742d23146c5f2c0d196b8ba824e477e9f2a0d4ae6e')

package() {
  local f
  for f in Main.qml metadata.desktop theme.conf; do
    install -Dm644 "$f" "$pkgdir/usr/share/sddm/themes/synapseos/$f"
  done
}
